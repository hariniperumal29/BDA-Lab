from pyspark.sql import SparkSession
sc= SparkSession.builder.appName("CSVRDD").getOrCreate()

rdd = sc.read.format("csv")\
      .option("header","true")\
      .option("inferSchema","true")\
      .load("Book1.csv").rdd

print(rdd.take(5))

df = rdd.toDF()
df.describe().show()
